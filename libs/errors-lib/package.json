{
  "name": "@move/errors-lib",
  "version": "1.0.0",
  "description": "Errors middleware for service-based architecture",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "clean": "rm -rf dist",
    "clean:build": "npm run clean && npm run build",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "biome:check": "biome check .",
    "biome:ci": "biome check . --reporter json --diagnostic-level=error > biome-report.json || true",
    "biome:fix": "biome check --write ."
  },
  "dependencies": {
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "@move/logs-lib": "file:../logs-lib"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
