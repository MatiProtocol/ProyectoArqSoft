NODE_ENV=development

IDENTITY_SERVICE_PORT=4001
BOOKING_SERVICE_PORT=4002
CONFIGURATION_SERVICE_PORT=4003
TRACKING_SERVICE_PORT=4004

IDENTITY_SERVICE_URL=http://your-identity-service:4001
BOOKING_SERVICE_URL=http://your-booking-service:4002
CONFIGURATION_SERVICE_URL=http://your-configuration-service:4003
TRACKING_SERVICE_URL=http://your-tracking-service:4004
CONFIGURATION_INTERNAL_TOKEN=change-me-internal-token
IDENTITY_INTERNAL_TOKEN=change-me-identity-internal-token

MONGO_URL=mongodb://app:app@your-mongo:27017/move?authSource=admin
MONGO_USER=your-user
MONGO_PASSWORD=your-password
MONGO_DB=your-db

REDIS_URL=redis://your-redis:6379

GPS_DEVICE_SECRET=change-me-device-secret
PROLONGED_STOP_RADIUS_METERS=30
PROLONGED_STOP_WINDOW_MS=120000
PROLONGED_STOP_MIN_READINGS=5

GOOGLE_GENAI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=10000
CONFIGURATION_SERVICE_TIMEOUT_MS=5000
IDENTITY_SERVICE_TIMEOUT_MS=5000
GEMINI_CLASSIFICATION_PROMPT="Classify the following MOVE shipment items using the attached MOVE category catalog CSV as the only valid source of categories. Return only valid JSON with recognized (boolean) and items (array). Items must include index (number) and category (string). Return category values using the category_name column exactly. If any item cannot be classified with confidence, return {\"recognized\":false,\"items\":[]}."
OPERATOR_WEBHOOK_URL=https://webhook.site/xxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GMAIL_USER=move@example.com
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_TIMEOUT_MS=10000

OSRM_URL=http://router.project-osrm.org
OSRM_TIMEOUT_MS=2000
BASE_RATE_PER_KM=5.0
SURCHARGE_PERCENT_PER_RULE=20
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_TIMEOUT_MS=3000
PAYMENT_DEFAULT_OUTCOME=accepted

AUTH0_DOMAIN=your-auth0-domain    # ej: dev-xxxx.us.auth0.com
AUTH0_AUDIENCE=https://your-api-audience


AUTH0_CLIENT_ID=your-auth0-app-client-id
AUTH0_CLIENT_SECRET=your-auth0-app-client-secret

SIM_USER_INDIVIDUAL_EMAIL=sim-individual@example.com
SIM_USER_INDIVIDUAL_PASSWORD=change-me
SIM_USER_COMPANY_EMAIL=sim-company@example.com
SIM_USER_COMPANY_PASSWORD=change-me
SIM_USER_OPERATOR_EMAIL=sim-operator@example.com
SIM_USER_OPERATOR_PASSWORD=change-me

SERVICE_NAME=move-service
NODE_APP_INSTANCE=0

#---Logs---
LOG_LEVEL=info
FILE_LOG_LEVEL=debug
LOG_DIRECTORY=./logs
LOG_MAX_SIZE=100m
LOG_MAX_FILES=7d


CACHE_MAX_ENTRIES=5
CACHE_MAX_AGE=600000
TIMEOUT_CACHE=5000
TIMEOUT_CIRCUIT_BREAKER=5000
ERROR_THRESHOLD_PERCENTAGE_CIRCUIT_BREAKER_AUTH0=50
RESET_TIMEOUT_CIRCUIT_BREAKER_AUTH0=30000
ROLLING_COUNT_TIMEOUT_CIRCUIT_BREAKER__AUTH0=10000
ROLLING_COUNT_BUCKETS_CIRCUIT_BREAKER_AUTH0=10
NAME_CIRCUIT_BREAKER_AUTH0=auth0-validation

ADMIN_ID=1
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PHONE=000000000
ADMIN_CITY='Default City'